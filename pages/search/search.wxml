<!-- 搜索页面 -->
<view class="container">
  <!-- 搜索头部 -->
  <view class="search-header">
    <!-- 搜索输入框 -->
    <view class="search-input-container">
      <input 
        class="search-input" 
        placeholder="搜索描述或标签..." 
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="search"
        confirm-type="search"
      />
      <view class="search-icon" bindtap="search">🔍</view>
    </view>
    
    <!-- 筛选选项 -->
    <view class="filter-options">
      <view 
        class="filter-option {{activeFilter === 'tag' ? 'active' : ''}}" 
        bindtap="switchFilter" 
        data-filter="tag"
      >
        <text>标签</text>
      </view>
      <view 
        class="filter-option {{activeFilter === 'date' ? 'active' : ''}}" 
        bindtap="switchFilter" 
        data-filter="date"
      >
        <text>日期</text>
      </view>
      <view 
        class="filter-option {{activeFilter === 'all' ? 'active' : ''}}" 
        bindtap="switchFilter" 
        data-filter="all"
      >
        <text>全部</text>
      </view>
    </view>
  </view>
  
  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilterPanel}}">
    <!-- 标签筛选 -->
    <view class="tag-filter" wx:if="{{activeFilter === 'tag'}}">
      <view class="filter-title">选择标签</view>
      <view class="tags-list">
        <view 
          class="tag-item {{selectedTags.includes(tag.name) ? 'selected' : ''}}" 
          wx:for="{{allTags}}" 
          wx:for-item="tag" 
          wx:key="name"
          bindtap="toggleTag"
          data-tag="{{tag.name}}"
        >
          <text class="tag-name">{{tag.name}}</text>
          <text class="tag-count">({{tag.count}})</text>
        </view>
      </view>
    </view>
    
    <!-- 日期筛选 -->
    <view class="date-filter" wx:if="{{activeFilter === 'date'}}">
      <view class="filter-title">选择日期范围</view>
      <view class="date-range">
        <view class="date-picker-container">
          <text class="date-label">开始日期</text>
          <picker 
            mode="date" 
            value="{{startDate}}" 
            bindchange="onStartDateChange"
          >
            <view class="date-picker">
              <text>{{startDate || '请选择'}}</text>
            </view>
          </picker>
        </view>
        <view class="date-separator">至</view>
        <view class="date-picker-container">
          <text class="date-label">结束日期</text>
          <picker 
            mode="date" 
            value="{{endDate}}" 
            bindchange="onEndDateChange"
          >
            <view class="date-picker">
              <text>{{endDate || '请选择'}}</text>
            </view>
          </picker>
        </view>
      </view>
    </view>
    
    <!-- 筛选操作按钮 -->
    <view class="filter-actions">
      <button class="reset-btn" bindtap="resetFilter">重置</button>
      <button class="apply-btn" bindtap="applyFilter">应用</button>
    </view>
  </view>
  
  <!-- 搜索结果 -->
  <view class="search-results">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>
    
    <!-- 结果列表 -->
    <block wx:elif="{{searchResults.length > 0}}">
      <view class="result-count">找到 {{searchResults.length}} 张照片</view>
      <view class="result-list">
        <view 
          class="result-item" 
          wx:for="{{searchResults}}" 
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <image class="result-image" src="{{item.url}}" mode="aspectFill" />
          <view class="result-info">
            <text class="result-date">{{item.date}}</text>
            <view class="result-tags" wx:if="{{item.tags && item.tags.length}}">
              <text 
                class="result-tag" 
                wx:for="{{item.tags}}" 
                wx:for-item="tag" 
                wx:key="tag"
              >{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <block wx:if="{{hasSearched}}">
        <view class="empty-icon">🔍</view>
        <text class="empty-text">未找到相关照片</text>
        <text class="empty-subtitle">尝试其他关键词或筛选条件</text>
      </block>
      <block wx:else>
        <view class="empty-icon">🔎</view>
        <text class="empty-text">搜索照片</text>
        <text class="empty-subtitle">输入关键词或使用筛选条件查找照片</text>
      </block>
    </view>
  </view>
</view> 