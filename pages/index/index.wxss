/* pages/index/index.wxss */ 
.container {
  background: linear-gradient(180deg, #F6F6FA 0%, #FAFBFC 100%);
  min-height: 100vh;
  position: relative;
}

.timeline-scroll {
  height: calc(100vh - 100rpx);
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 时间线容器 */
.timeline {
  padding: 32rpx 0;
  position: relative;
}

/* 时间线项目 */
.timeline-item {
  position: relative;
  margin-bottom: 40rpx;
  padding-left: 60rpx;
}

/* 时间线圆点 */
.timeline-dot {
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #FF7BAC, #8BD3E6);
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(255, 123, 172, 0.1);
  z-index: 2;
}

/* 时间线连接线 */
.timeline-line {
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background: linear-gradient(180deg, #FF7BAC, #8BD3E6);
  opacity: 0.3;
  z-index: 1;
}

/* 动态卡片 */
.moment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 123, 172, 0.08);
  position: relative;
  overflow: hidden;
}

.moment-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #FF7BAC, #8BD3E6);
}

/* 动态头部 */
.moment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.moment-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.moment-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  font-family: 'Courier New', monospace;
  letter-spacing: 0.5rpx;
}

.moment-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 123, 172, 0.1);
  border: 1rpx solid rgba(255, 123, 172, 0.2);
}

.action-text {
  font-size: 24rpx;
  color: #FF7BAC;
}

/* 动态描述 */
.moment-desc {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: rgba(255, 123, 172, 0.03);
  border-radius: 12rpx;
  border-left: 4rpx solid #FF7BAC;
}

.moment-desc text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 照片网格 */
.moment-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.moment-photo {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.moment-photo.single-photo {
  grid-column: span 3;
  height: 400rpx;
}

/* 当有2张照片时的特殊布局 */
.moment-photos.two-photos {
  grid-template-columns: repeat(2, 1fr);
}

.moment-photos.two-photos .moment-photo {
  height: 300rpx;
}

/* 标签 */
.moment-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.moment-tag {
  background: linear-gradient(135deg, #FF7BAC, #8BD3E6);
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
} 