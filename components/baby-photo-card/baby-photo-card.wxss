/* components/baby-photo-card/baby-photo-card.wxss */

.photo-card {
  position: relative;
  aspect-ratio: 3/4;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  box-shadow: 0 4px 12px rgba(255, 123, 172, 0.1);
}
.photo {
  width: 100%;
  height: 100%;
}
.date-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background-color: rgba(255,123,172,0.8);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.tags {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}
.tag {
  background-color: rgba(255,209,102,0.8);
  color: #333;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
} 